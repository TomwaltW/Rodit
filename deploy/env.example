# 本地试用（deploy/docker-compose.yml，只用合成数据）的密钥模板，只有占位符。复制成 deploy/.env 再填值：
#   cp deploy/env.example deploy/.env
# 每个值都填随机串，例如 openssl rand -hex 32（十六进制，放进连接串不用转义）。
# deploy/.env 已被 .gitignore 忽略，不要提交。生产环境的值由平台云的密钥管理注入，不用这个文件。

# 店铺令牌加密密钥（应用内 AES-256-GCM，§8.4）
RODIT_TOKEN_KEY=
# buyer_ref 哈希的盐（§8.3）
RODIT_BUYER_SALT=
# 本地 PostgreSQL：属主账号（迁移用）和应用账号（rodit_login，属于 rodit_app，行级安全生效）
RODIT_DB_OWNER_PASSWORD=
RODIT_DB_APP_PASSWORD=

# 可选：本机开发用的境内已备案大模型（OpenAI 兼容接口）。留空就用离线替身（只复述依据）。
RODIT_LLM_BASE_URL=
RODIT_LLM_MODEL=
RODIT_LLM_API_KEY=
