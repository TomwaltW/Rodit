{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-setup.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
